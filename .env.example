# Postgres connection (SQLAlchemy URL).
DATABASE_URL=postgresql+psycopg://affiliate:affiliate@localhost:5432/affiliate
# Clients (e.g. Reels Studio) send this in the X-API-Key header. Required.
API_KEY=change-me
# Fernet key that encrypts saved login sessions. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
# Where debug dumps of captured responses go.
DATA_DIR=data
# Seconds to wait between page loads. Keep it slow: fast scraping gets accounts blocked.
SCRAPE_DELAY_SECONDS=5
# Upper limit on pages per search job.
MAX_PAGES=5
# 0 shows the browser window (useful when debugging locally).
HEADLESS=1
# Site base URLs. Tests point these at a local fake server.
SHOPEE_BASE_URL=https://shopee.vn
SHOPEE_AFFILIATE_BASE_URL=https://affiliate.shopee.vn
TIKTOK_BASE_URL=https://www.tiktok.com
TIKTOK_AFFILIATE_BASE_URL=https://affiliate.tiktok.com
# Page paths can be overridden without a code change when a site moves a page, e.g.:
# PATH_SHOPEE_OFFERS=/offer/product_offer?keyword={keyword}&page={page}
